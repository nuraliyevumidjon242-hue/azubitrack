# ---------------------------------------------------------------------------
# AzubiTrack — environment configuration
# Copy this file to `.env` and adjust the values.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma separated list of allowed origins for CORS (frontend dev server)
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Option A (default, zero setup): local SQLite file powered by node:sqlite.
# Leave DATABASE_URL empty to use SQLite.
SQLITE_PATH=./data/azubitrack.db

# Option B (production / docker-compose): PostgreSQL.
# When DATABASE_URL is set it takes precedence over SQLITE_PATH.
# DATABASE_URL=postgres://azubitrack:azubitrack@localhost:5432/azubitrack

# Optional Redis (used for AI response caching). If unreachable, the app
# transparently falls back to the database cache.
# REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Authentication — use long random values in production!
# Generate e.g. with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-0123456789abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-0123456789abcdef
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------------------
# AI text optimization (optional).
# Without a key the backend uses a deterministic local fallback so the app
# remains fully usable in demo mode.
# ---------------------------------------------------------------------------
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Maximum number of characters accepted per optimization request
AI_MAX_INPUT_CHARS=1000
# Maximum number of characters returned by the AI service
AI_MAX_OUTPUT_CHARS=500

# ---------------------------------------------------------------------------
# Demo mode
# ---------------------------------------------------------------------------
# Lifetime of an ephemeral demo workspace in minutes
DEMO_TTL_MINUTES=120

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
AUTH_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_MAX=10
